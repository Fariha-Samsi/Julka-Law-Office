<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Law Office of Harvinder Julka</title>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&display=swap" rel="stylesheet">

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Inter', sans-serif;
    color: #333;
}

/* NAVBAR */
nav {
    position: sticky;
    top: 0;
    background: white;
    display: flex;
    justify-content: space-between;
    padding: 15px 40px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    z-index: 1000;
}

nav h2 {
    color: #1a2a44;
}

nav a {
    margin-left: 20px;
    text-decoration: none;
    color: #333;
    font-weight: 500;
}

/* HERO */
.hero {
    height: 90vh;
    background: linear-gradient(rgba(26,42,68,0.8), rgba(26,42,68,0.8)),
                url('https://images.unsplash.com/photo-1589829545856-d10d557cf95f');
    background-size: cover;
    background-position: center;
    color: white;
    display: flex;
    align-items: center;
    padding: 0 40px;
}

.hero-text {
    max-width: 600px;
}

.hero h1 {
    font-size: 48px;
    margin-bottom: 20px;
}

.hero p {
    font-size: 18px;
    margin-bottom: 20px;
}

.btn {
    padding: 12px 25px;
    background: #f4b400;
    color: black;
    text-decoration: none;
    font-weight: 600;
    border-radius: 5px;
}

/* SECTIONS */
section {
    padding: 60px 40px;
}

.container {
    max-width: 1100px;
    margin: auto;
}

/* SERVICES */
.services {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 25px;
}

.card {
    padding: 25px;
    border-radius: 10px;
    background: #f9f9f9;
    transition: 0.3s;
}

.card:hover {
    transform: translateY(-5px);
}

/* CONTACT */
.contact-form input,
.contact-form textarea {
    width: 100%;
    padding: 10px;
    margin: 10px 0;
    border-radius: 5px;
    border: 1px solid #ccc;
}

iframe {
    width: 100%;
    height: 300px;
    border: 0;
    margin-top: 20px;
}

/* FOOTER */
footer {
    background: #1a2a44;
    color: white;
    text-align: center;
    padding: 20px;
}

/* MOBILE */
@media(max-width: 768px) {
    .hero h1 {
        font-size: 32px;
    }
}
</style>
</head>

<body>

<nav>
    <h2>HJ Law Office</h2>
    <div>
        <a href="#home">Home</a>
        <a href="#services">Services</a>
        <a href="#contact">Contact</a>
    </div>
</nav>

<section class="hero" id="home">
    <div class="hero-text">
        <h1>Trusted Legal Services in New York</h1>
        <p>Dedicated to providing professional and reliable legal assistance tailored to your needs.</p>
        <a href="#contact" class="btn">Get Consultation</a>
    </div>
</section>

<section>
    <div class="container">
        <h2>About Us</h2>
        <p>
            The Law Office of Harvinder Julka provides personalized legal services with a focus on 
            professionalism, efficiency, and client satisfaction. We handle each case with care and attention.
        </p>
    </div>
</section>

<section>
    <div class="container">
        <h2>Our Services</h2>
        <div class="services">
            <div class="card">
                <h3>Immigration Law</h3>
                <p>Helping clients navigate complex immigration processes.</p>
            </div>
            <div class="card">
                <h3>Family Law</h3>
                <p>Support for family-related legal matters and disputes.</p>
            </div>
            <div class="card">
                <h3>Business Law</h3>
                <p>Legal assistance for businesses and entrepreneurs.</p>
            </div>
            <div class="card">
                <h3>Consultation</h3>
                <p>Professional advice tailored to your situation.</p>
            </div>
        </div>
    </div>
</section>

<section id="contact">
    <div class="container">
        <h2>Contact Us</h2>

        <form class="contact-form">
            <input type="text" placeholder="Your Name" required>
            <input type="email" placeholder="Your Email" required>
            <textarea rows="5" placeholder="Your Message"></textarea>
            <button class="btn">Send Message</button>
        </form>

        <p><strong>Address:</strong> 101-05 Lefferts Blvd Ste 207, South Richmond Hill, NY 11419</p>

        <iframe 
            src="https://maps.google.com/maps?q=101-05%20Lefferts%20Blvd%20Ste%20207%20South%20Richmond%20Hill%20NY&t=&z=13&ie=UTF8&iwloc=&output=embed">
        </iframe>

    </div>
</section>

<footer>
    <p>© 2026 Law Office of Harvinder Julka</p>
</footer>

</body>
</html>
